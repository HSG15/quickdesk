# QuickDesk Environment Configuration

# Server
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname> or postgresql://...
DATABASE_URL=postgresql://localhost:5432/quickdesk

# Authentication (JWT)
# Generate a secure key in production with: openssl rand -hex 32
JWT_SECRET_KEY=dev_secret_key_quickdesk_ai_assessment_2026_change_in_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# AI Configuration (Groq Cloud LLM)
# Obtain free API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# Vector Database (Chroma)
CHROMA_PERSIST_DIRECTORY=./backend/chroma_db
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
